<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Build output paths configuration -->
  <PropertyGroup>
    <PciswApiOutDirRoot>$(SolutionDir)bin</PciswApiOutDirRoot>
    <PciswApiIntDirRoot>$(SolutionDir).temp\$(MSBuildProjectName)\</PciswApiIntDirRoot>
  </PropertyGroup>
  <PropertyGroup>
    <PciswApiOutDir>$(PciswApiOutDirRoot)\$(Platform)\$(Configuration)\</PciswApiOutDir>
    <PciswApiIntDir>$(PciswApiIntDirRoot)\$(Platform)\$(Configuration)\</PciswApiIntDir>
  </PropertyGroup>
  <!-- Runtime Library configuration -->
  <PropertyGroup>
    <!-- Uncomment this to override the runtime library linkage type used by pcisw-api.
    <PciswApiRuntimeLib>Static</PciswApiRuntimeLib>
    -->
    <!-- Set library-internal C++ language standard to C++23. If not set, C++17 is used by default.
    <PciswCxxStandard>stdcpp23</PciswCxxStandard>
    -->
  </PropertyGroup>
</Project>
